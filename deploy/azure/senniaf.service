[Unit]
Description=SENNIAF Match - demostracion remota
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=exec
DynamicUser=yes
WorkingDirectory=/srv/senniaf
EnvironmentFile=/etc/senniaf/remoto.env
ExecStart=/usr/bin/java -Xms128m -Xmx768m -jar /srv/senniaf/current.jar --spring.profiles.active=remoto
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
