# Instalar solo en una VM dedicada. Sustituir DEMO_DOMAIN por el dominio aprobado.
# Crear certificados válidos y abrir 80/443 únicamente tras autorización.
server {
    listen 80;
    server_name DEMO_DOMAIN;
    if ($host != DEMO_DOMAIN) { return 444; }
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://DEMO_DOMAIN$request_uri; }
}
server {
    listen 443 ssl;
    server_name DEMO_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/DEMO_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DEMO_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    proxy_hide_header Strict-Transport-Security;
    if ($host != DEMO_DOMAIN) { return 444; }
    server_tokens off;
    client_max_body_size 128k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    include /etc/senniaf/acceso-publico.conf;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }
}
