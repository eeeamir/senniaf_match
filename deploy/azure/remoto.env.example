# Copiar únicamente al servidor como /etc/senniaf/remoto.env (root:root, 0600).
# No usar datos ni credenciales de desarrollo. Ninguno de estos valores es un secreto válido.
SPRING_PROFILES_ACTIVE=remoto
DB_URL=jdbc:postgresql://127.0.0.1:5432/senniaf_demo
DB_USERNAME=senniaf_app
DB_PASSWORD=REEMPLAZAR_CON_32_BYTES_ALEATORIOS
SENNIAF_PUBLIC_ORIGIN=https://REEMPLAZAR_DOMINIO.invalid
SENNIAF_CODIGO_DEMO=false
SENNIAF_DEMO_HABILITADO=false
# Mantener false hasta comprobar entrega real, verificación, límites y autorización.
SENNIAF_REGISTRO_PUBLICO=false
SMTP_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=REEMPLAZAR_LOGIN_SMTP
SMTP_PASSWORD=REEMPLAZAR_CLAVE_SMTP_NO_API
SMTP_FROM=REEMPLAZAR_REMITENTE_VERIFICADO
SMTP_DAILY_LIMIT=200
